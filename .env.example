# ==============================================================================
# DIGITOL AGENCY - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. Lead Notification Email (Where you want form submissions to arrive)
NOTIFICATION_EMAIL=your-email@gmail.com
SENDER_EMAIL=leads@godigitol.com

# 2. Option A: Resend API (Recommended for Vercel / Serverless - https://resend.com)
RESEND_API_KEY=re_123456789abcdef

# 3. Option B: SendGrid API (https://sendgrid.com)
# SENDGRID_API_KEY=SG.123456789abcdef

# 4. Option C: Standard SMTP (Gmail, Outlook, AWS SES, Custom Mail Server)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_USE_TLS=true

# 5. Option D: Webhook Notification (Slack, Discord, Zapier, Make, GoHighLevel)
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
