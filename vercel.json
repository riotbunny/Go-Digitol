{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "includeFiles": "templates/**,static/**,data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
